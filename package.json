{
  "name": "daccache-farms-agrios-portable",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "pg": "^8.16.0",
    "maplibre-gl": "^5.0.0",
    "echarts": "^6.0.0",
    "lucide-react": "^1.31.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "radix-ui": "^1.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/pg": "^8.15.0",
    "@playwright/test": "^1.56.0",
    "@next/env": "16.3.4",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1"
  }
}
