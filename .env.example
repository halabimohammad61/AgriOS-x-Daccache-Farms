# npm run setup creates real values. Never commit .env or .env.local.
DATABASE_URL=postgresql://agrios:CHANGE_ME@127.0.0.1:5432/agrios
POSTGRES_PASSWORD=CHANGE_ME
AGRIOS_PASSWORD_HASH=GENERATED_BY_SETUP
AGRIOS_SESSION_SECRET=GENERATED_BY_SETUP
# Keep false for local HTTP. Use true only behind HTTPS.
AGRIOS_SECURE_COOKIE=false
# Optional: specific design file, not a Figma dashboard URL
FIGMA_DESIGN_URL=
